# ============================================================================
# Renault Logan key — LIVE parametric model for FreeCAD
# ============================================================================
#
# Unlike a plain "build once and export" macro, this creates real FreeCAD
# *scripted parametric objects* (Part::FeaturePython): a single "KeyParameters"
# object holds every dimension as an ordinary FreeCAD Property (grouped in the
# Property panel — Head / Blade / Fob / Buttons / Immobilizer / Keyring /
# Assembly Screws / Fit), and three shape objects (BottomShell, TopShell,
# KeyAssembled) that read from it and rebuild their Shape on recompute.
#
# WORKFLOW (all inside FreeCAD, no code editing):
#   1. Run this macro once (Macro -> Macros... -> Execute, or freecadcmd).
#   2. In the model tree, select "KeyParameters".
#   3. In the Property panel, change any value (e.g. head_length, chip_width,
#      button_x/button_y, ...).
#   4. Recompute (the round-arrows toolbar button, or F5, or it may happen
#      automatically depending on your "recompute on change" preference).
#      BottomShell / TopShell / KeyAssembled all rebuild from the new values.
#   5. Export whichever shape you want via File -> Export (STL for printing,
#      STEP for other CAD).
#
# Re-running the macro (e.g. after reopening the file in a new FreeCAD
# session) is safe: it reuses the existing KeyParameters/shape objects and
# just re-attaches their live-recompute behaviour, WITHOUT discarding any
# values you already edited. It only creates fresh objects with the defaults
# below the first time (or if you deleted them).
#
# ----------------------------------------------------------------------------
# This is a from-scratch FreeCAD port of the geometry validated in
# cad/renault_logan_key.py (CadQuery). The environment that wrote this file
# has no FreeCAD install, so it could not be run inside real FreeCAD -- it WAS
# verified by executing the identical Part-API call sequence directly against
# the OpenCASCADE kernel FreeCAD's own Part module wraps (same makeBox /
# makeCylinder / fuse / cut / makeFillet calls), including a live "edit a
# property, recompute, confirm the shape changed accordingly" cycle, not just
# a one-shot build. Bounding boxes / exact BREP volumes matched the CadQuery
# model. The one thing that couldn't be exercised from outside FreeCAD is the
# literal FreeCAD module surface itself (Part::FeaturePython persistence
# across save/reload, the Property panel UI, addProperty's exact runtime
# behaviour) -- if something looks off there, the geometry underneath it is
# already proven correct; it'll be a FreeCAD-API detail to adjust.
#
# See cad/renault_logan_key.py for the full design write-up (blade retention,
# fob cavity, immobilizer snap-fit nest, etc.).
# ============================================================================

import math

import FreeCAD as App
import Part

try:
    import FreeCADGui as Gui
except Exception:
    Gui = None


DOC_NAME = "RenaultLoganKey"
EPS = 0.02


# ============================================================================
# Geometry helpers (Part API) -- unchanged from the static macro, verified
# against CadQuery's identical model.
# ============================================================================

def _vertical_edges(shape, tol=1e-6):
    edges = []
    for e in shape.Edges:
        v0 = e.Vertexes[0].Point
        v1 = e.Vertexes[-1].Point
        if abs(v0.x - v1.x) < tol and abs(v0.y - v1.y) < tol and abs(v0.z - v1.z) > tol:
            edges.append(e)
    return edges


def rrect_solid(length, width, height, radius):
    """Rounded rectangular prism, centred on X=Y=0, sitting on Z=0."""
    r = min(radius, length / 2 - 0.01, width / 2 - 0.01)
    box = Part.makeBox(length, width, max(height, 0.001),
                       App.Vector(-length / 2, -width / 2, 0))
    if r > 0.05:
        edges = _vertical_edges(box)
        if edges:
            box = box.makeFillet(r, edges)
    return box


def rrect_ring(length, width, height, radius, ring_width):
    """Hollow rounded-rectangle ring (picture-frame), centred on X=Y=0."""
    outer = rrect_solid(length, width, height + 2 * EPS, radius)
    outer.translate(App.Vector(0, 0, -EPS))
    inner = rrect_solid(length - 2 * ring_width, width - 2 * ring_width,
                        height + 4 * EPS, max(radius - ring_width, 0.4))
    inner.translate(App.Vector(0, 0, -2 * EPS))
    return outer.cut(inner)


def cyl(dia, x, y, z0, height):
    """Vertical cylinder (a boss or a cutting peg)."""
    return Part.makeCylinder(dia / 2, max(height, 0.001), App.Vector(x, y, z0), App.Vector(0, 0, 1))


def ball(radius, x, y, z):
    """Sphere centred at (x, y, z) -- used to cut a shallow finger dish."""
    return Part.makeSphere(radius, App.Vector(x, y, z))


def box_at(dx, dy, dz, x, y, z0, cx=True, cy=True):
    ox = x - dx / 2 if cx else x
    oy = y - dy / 2 if cy else y
    return Part.makeBox(dx, dy, max(dz, 0.001), App.Vector(ox, oy, z0))


def button_angle(p, index, bx, by):
    if p.button_radial:
        return math.degrees(math.atan2(by, bx))
    return p.button_angles[index]


def button_slot_solid(p, bx, by, index, height, z0):
    angle = button_angle(p, index, bx, by) + 90
    slot = rrect_solid(p.button_slot_l, p.button_slot_w, height, p.button_slot_r)
    slot.rotate(App.Vector(0, 0, 0), App.Vector(0, 0, 1), angle)
    slot.translate(App.Vector(p.fob_center_x + bx, by, z0))
    return slot


def button_dimple_cut(p, bx, by):
    """Shallow spherical-cap dish in the top's OUTER face around a button
    opening. Sagitta geometry: a sphere of radius R positioned so its cap,
    sliced by the outer face (z=h), has the requested rim radius r and centre
    depth d -- R = (r^2 + d^2) / (2d), sphere centred (R - d) above that face."""
    h = p.head_height - p.split_z
    r = p.button_dimple_dia / 2
    d = p.button_dimple_depth
    R = (r * r + d * d) / (2 * d)
    return ball(R, p.fob_center_x + bx, by, h + R - d)


# ============================================================================
# Feature cutters (global coordinates)
# ============================================================================

def fob_cavity(p, z0, height):
    s = rrect_solid(p.fob_length + 2 * p.fob_clearance, p.fob_width + 2 * p.fob_clearance,
                    height, p.fob_corner_r + p.fob_clearance)
    s.translate(App.Vector(p.fob_center_x, 0, z0))
    return s


def blade_channel(p):
    bw = p.blade_slot_width
    bt = p.blade_thickness + p.clearance
    fob_front = p.fob_center_x - p.fob_length / 2 - p.fob_clearance
    chan_len = fob_front + 2.5
    return box_at(chan_len + EPS, bw, bt, -EPS, 0, p.blade_z0, cx=False)


def chip_pocket(p):
    """Full width below chip_snap_z; narrower (overhanging snap lip) from
    there up to the parting plane -- the chip is captive in the bottom half
    alone (press past the lip; it springs back over the chip)."""
    if p.chip_across:
        full_l, full_w = p.chip_width + p.clearance, p.chip_length + p.clearance
    else:
        full_l, full_w = p.chip_length + p.clearance, p.chip_width + p.clearance

    z0 = p.chip_floor
    snap_z = p.chip_snap_z
    lower = box_at(full_l, full_w, snap_z - z0 + EPS, p.chip_center_x, p.chip_center_y, z0)

    if p.chip_across:
        narrow_l = max(full_l - 2 * p.chip_snap_overlap, 1.0)
        narrow_w = full_w
    else:
        narrow_l = full_l
        narrow_w = max(full_w - 2 * p.chip_snap_overlap, 1.0)
    upper = box_at(narrow_l, narrow_w, p.split_z - snap_z + EPS,
                   p.chip_center_x, p.chip_center_y, snap_z - EPS)

    return lower.fuse(upper)


def chip_holddown_pad(p):
    chip_top = p.chip_floor + p.chip_thickness
    depth = p.split_z - chip_top - p.chip_holddown_gap
    if depth <= 0:
        return None
    if p.chip_across:
        pad_l = max(p.chip_width - 2 * p.chip_snap_overlap - 0.6, 1.0)
        pad_w = p.chip_length - 1.0
    else:
        pad_l = p.chip_length - 1.0
        pad_w = max(p.chip_width - 2 * p.chip_snap_overlap - 0.6, 1.0)
    return box_at(pad_l, pad_w, depth + EPS, p.chip_center_x, p.chip_center_y, -depth)


def fob_retainers(p):
    """One small crush rib per long (Y) cavity wall, gripping the fob edge so
    it can't rattle or spin."""
    g = p.fob_retainer_grip
    rib_len = p.fob_retainer_thickness
    inner = p.fob_width / 2 - g
    outer = p.fob_width / 2 + p.fob_clearance + 1.0
    cy_pos = (inner + outer) / 2
    dy = outer - inner
    rib_x = p.fob_center_x + p.fob_retainer_dx
    ribs = None
    for sy in (1, -1):
        r = box_at(rib_len, dy, p.split_z - p.wall + EPS, rib_x, sy * cy_pos, p.wall)
        ribs = r if ribs is None else ribs.fuse(r)
    return ribs


def lip_ring(p, height, grow=0.0):
    w = p.lip_width + 2 * grow
    outer_len = (p.head_length - p.wall) + w
    outer_wid = (p.head_width - p.wall) + w
    rad = max(p.corner_radius - (p.wall - w) / 2, 0.6)
    return rrect_ring(outer_len, outer_wid, height, rad, w)


# ============================================================================
# Shell halves
# ============================================================================

def bottom_shell(p):
    cx = p.head_length / 2
    b = rrect_solid(p.head_length, p.head_width, p.split_z, p.corner_radius)
    b.translate(App.Vector(cx, 0, 0))

    b = b.cut(fob_cavity(p, p.wall, p.split_z))

    if p.fob_retain:
        b = b.fuse(fob_retainers(p))

    skirt = 0.6
    lip = lip_ring(p, p.lip_height + skirt)
    lip.translate(App.Vector(cx, 0, p.split_z - skirt))
    b = b.fuse(lip)

    trim = rrect_solid(p.head_length, p.head_width, p.split_z + p.lip_height + 1, p.corner_radius)
    trim.translate(App.Vector(cx, 0, 0))
    b = b.common(trim)

    b = b.cut(blade_channel(p))
    b = b.cut(chip_pocket(p))
    b = b.cut(cyl(p.keyring_hole_dia, p.keyring_x, p.keyring_y, -EPS, p.split_z + 2 * EPS))

    floor_keep = 1.0
    for (x, y) in p.asm_positions:
        b = b.cut(cyl(p.asm_pilot_dia, x, y, floor_keep, p.split_z - floor_keep + EPS))
    if p.use_blade_bolt:
        b = b.cut(cyl(p.blade_pilot_dia, p.bolt_offset, 0, floor_keep, p.split_z - floor_keep + EPS))
    return b


def top_shell(p):
    cx = p.head_length / 2
    h = p.head_height - p.split_z
    t = rrect_solid(p.head_length, p.head_width, h, p.corner_radius)
    t.translate(App.Vector(cx, 0, 0))

    # No cavity cut here: an early print with the fob pocket open on BOTH
    # halves let the fob rattle (too much total depth). Leaving the top solid
    # over the fob region relies on the bottom pocket alone to hold it snug.

    groove = lip_ring(p, p.lip_height + p.clearance, grow=p.clearance)
    groove.translate(App.Vector(cx, 0, 0))
    t = t.cut(groove)

    t = t.cut(cyl(p.keyring_hole_dia, p.keyring_x, p.keyring_y, -EPS, h + 2 * EPS))

    for i, (bx, by) in enumerate(p.button_positions):
        slot = button_slot_solid(p, bx, by, i, h + 2 * EPS, -EPS)
        t = t.cut(slot)
        if p.button_dimple:
            t = t.cut(button_dimple_cut(p, bx, by))

    if p.chip_holddown:
        pad = chip_holddown_pad(p)
        if pad is not None:
            t = t.fuse(pad)

    for (x, y) in p.asm_positions:
        t = t.cut(cyl(p.asm_clear_dia, x, y, -EPS, h + 2 * EPS))
        t = t.cut(cyl(p.asm_head_dia, x, y, h - p.asm_head_depth, p.asm_head_depth + EPS))

    if p.use_blade_bolt:
        t = t.cut(cyl(p.blade_clear_dia, p.bolt_offset, 0, -EPS, h + 2 * EPS))
        t = t.cut(cyl(p.blade_head_dia, p.bolt_offset, 0, h - p.blade_head_depth, p.blade_head_depth + EPS))
    return t


def print_ready_top(p):
    """Top half flipped flat-side-down for printing (open face up)."""
    h = p.head_height - p.split_z
    t = top_shell(p)
    t.rotate(App.Vector(0, 0, 0), App.Vector(1, 0, 0), 180)
    t.translate(App.Vector(0, 0, h))
    return t


def assembled(p):
    b = bottom_shell(p)
    t = top_shell(p)
    t.translate(App.Vector(0, 0, p.split_z))
    return b.fuse(t)


# ============================================================================
# Reference geometry (fit-check only)
# ============================================================================

def blade_reference(p):
    z0 = p.blade_z0
    tang = box_at(p.wall + p.blade_insert, p.blade_width, p.blade_thickness, 0, 0, z0, cx=False)
    shoulder = box_at(p.shoulder_length, p.shoulder_width, p.shoulder_thickness,
                      -p.shoulder_length, 0, z0, cx=False)
    blade = box_at(20, p.blade_width, p.blade_thickness, -p.shoulder_length - 20, 0, z0, cx=False)
    hole = cyl(p.tang_hole_dia, p.bolt_offset, 0, z0 - 1, p.blade_thickness + 2)
    return tang.fuse(shoulder).fuse(blade).cut(hole)


def chip_reference(p):
    if p.chip_across:
        dx, dy = p.chip_width, p.chip_length
    else:
        dx, dy = p.chip_length, p.chip_width
    return box_at(dx, dy, p.chip_thickness, p.chip_center_x, p.chip_center_y, p.chip_floor)


def fob_reference(p):
    body = rrect_solid(p.fob_length, p.fob_width, p.fob_body_thickness, p.fob_corner_r)
    body.translate(App.Vector(p.fob_center_x, 0, p.wall))
    fob = body
    for i, (bx, by) in enumerate(p.button_positions):
        angle = button_angle(p, i, bx, by) + 90
        btn = rrect_solid(p.button_slot_l - 1.5, p.button_slot_w - 1.5,
                          p.fob_button_height, max(p.button_slot_r - 0.3, 0.3))
        btn.rotate(App.Vector(0, 0, 0), App.Vector(0, 0, 1), angle)
        btn.translate(App.Vector(p.fob_center_x + bx, by, p.wall + p.fob_body_thickness))
        fob = fob.fuse(btn)
    return fob


# ============================================================================
# LiveParams -- adapts the FreeCAD KeyParameters object's Properties to the
# same attribute interface the geometry functions above expect (p.head_length,
# p.button_positions, p.blade_z0, ...), so none of those functions need to
# know or care whether they're driven by FreeCAD Properties or a plain object.
# ============================================================================

def _plain_number(v):
    """FreeCAD's App::PropertyLength values read back as Base.Quantity objects
    (a value + a unit, e.g. "58 mm"), not plain floats -- and Quantity's
    arithmetic is unit-checked, so e.g. `quantity - 0.01` (a bare, "unit-less"
    float) raises Base.UnitsMismatchError. Every geometry function below is
    written in plain floats (matching the CadQuery model exactly), so unwrap
    Quantity -> float right here, once, at the LiveParams boundary -- nothing
    downstream ever has to know FreeCAD Properties are involved at all."""
    if hasattr(v, "Value"):
        return float(v.Value)
    return v


class LiveParams:
    def __init__(self, obj):
        self._obj = obj

    def __getattr__(self, name):
        if name == "button_positions":
            xs = [_plain_number(v) for v in self._obj.button_x]
            ys = [_plain_number(v) for v in self._obj.button_y]
            return tuple(zip(xs, ys))
        if name == "asm_positions":
            xs = [_plain_number(v) for v in self._obj.asm_x]
            ys = [_plain_number(v) for v in self._obj.asm_y]
            return tuple(zip(xs, ys))
        if name == "button_angles":
            return tuple(_plain_number(v) for v in self._obj.button_angle_overrides)
        return _plain_number(getattr(self._obj, name))

    @property
    def split_z(self):
        return self.head_height * self.split_ratio

    @property
    def blade_z0(self):
        return self.split_z - (self.blade_thickness + self.clearance) - self.blade_top_gap

    @property
    def chip_floor(self):
        return max(self.split_z - self.chip_thickness - 0.6, self.wall + 0.3)

    @property
    def chip_snap_z(self):
        z = self.split_z - self.chip_snap_lip_height
        chip_top = self.chip_floor + self.chip_thickness
        return max(z, chip_top + 0.15)


# ============================================================================
# DEFAULT PARAMETER VALUES -- same numbers as cad/renault_logan_key.py.
# Used only the FIRST time KeyParameters is created; edits you make afterward
# in the Property panel are never overwritten by re-running this macro.
# ============================================================================

