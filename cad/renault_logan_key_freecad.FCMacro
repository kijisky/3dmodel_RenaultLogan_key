}

# FloatList properties (variable-length lists: buttons, assembly screws).
# (name, group, tooltip, default list)
_DEFAULT_LISTS = {
    "button_x": ("Buttons", "Button X offsets, FOB-LOCAL mm (one per button)", [-6.0, 6.0, 6.0]),
    "button_y": ("Buttons", "Button Y offsets, FOB-LOCAL mm (one per button)", [0.1, 6.0, -6.0]),
    "button_angle_overrides": ("Buttons", "Explicit angles in degrees, used only if button_radial=False", [0.0, 0.0, 0.0]),
    "asm_x": ("Assembly Screws", "Screw X positions, from the front face", [51.0, 51.0]),
    "asm_y": ("Assembly Screws", "Screw Y positions", [13.0, -13.0]),
}


def _define_parameters(obj):
    """addProperty + set DEFAULT values. Only ever called for a brand-new
    KeyParameters object -- never touches an existing one's current values."""
    for name, (typ, group, tip, default) in _DEFAULTS.items():
        obj.addProperty(typ, name, group, tip)
        setattr(obj, name, default)
    for name, (group, tip, default) in _DEFAULT_LISTS.items():
        obj.addProperty("App::PropertyFloatList", name, group, tip)
        setattr(obj, name, list(default))


# ============================================================================
# Part::FeaturePython proxy for the shape objects
# ============================================================================

class ShapeProxy:
    """Generic proxy: on recompute, calls the module-level builder function
    named in obj.Builder (a plain FreeCAD Property string, not a live Python
    reference, so it survives FreeCAD's save/reload of the document) with a
    LiveParams(obj.Params) view of the shared KeyParameters object."""

    def __init__(self, obj, params_obj, builder_name):
        if "Params" not in obj.PropertiesList:
            obj.addProperty("App::PropertyLink", "Params", "Link",
                            "The shared KeyParameters object driving this shape")
        obj.Params = params_obj
        if "Builder" not in obj.PropertiesList:
            obj.addProperty("App::PropertyString", "Builder", "Link",
                            "Name of the module-level function that builds this shape")
        obj.Builder = builder_name
        obj.Proxy = self

    def execute(self, obj):
        builder = globals()[obj.Builder]
        obj.Shape = builder(LiveParams(obj.Params))

    def __getstate__(self):
        return None

    def __setstate__(self, state):
        return None


class ViewProviderShape:
    """Minimal ViewProvider so the shape objects behave normally in the GUI
    (icon/selection); purely cosmetic, guarded so headless runs are unaffected."""

    def __init__(self, vobj):
        vobj.Proxy = self

    def getIcon(self):
        return ":/icons/Part_Box.svg"

    def attach(self, vobj):
        self.ViewObject = vobj

    def __getstate__(self):
        return None

    def __setstate__(self, state):
        return None


# ============================================================================
# Build (idempotent: safe to re-run without discarding edited values)
# ============================================================================

def get_or_create_document():
    if DOC_NAME in App.listDocuments():
        return App.getDocument(DOC_NAME)
    return App.newDocument(DOC_NAME)


def get_or_create_params(doc):
    obj = doc.getObject("KeyParameters")
    if obj is None:
        obj = doc.addObject("App::FeaturePython", "KeyParameters")
        _define_parameters(obj)
    return obj


def get_or_create_shape(doc, name, params_obj, builder_name):
    obj = doc.getObject(name)
    if obj is None:
        obj = doc.addObject("Part::FeaturePython", name)
    ShapeProxy(obj, params_obj, builder_name)
    if Gui is not None:
        try:
            ViewProviderShape(obj.ViewObject)
        except Exception:
            pass
    return obj


def build():
    doc = get_or_create_document()
    params_obj = get_or_create_params(doc)

    get_or_create_shape(doc, "BottomShell", params_obj, "bottom_shell")
    get_or_create_shape(doc, "TopShell", params_obj, "print_ready_top")
    get_or_create_shape(doc, "KeyAssembled", params_obj, "assembled")
    get_or_create_shape(doc, "RefBlade", params_obj, "blade_reference")
    get_or_create_shape(doc, "RefChip", params_obj, "chip_reference")
    get_or_create_shape(doc, "RefFob", params_obj, "fob_reference")

    doc.recompute()

    if Gui is not None:
        try:
            Gui.ActiveDocument = Gui.getDocument(doc.Name)
            Gui.ActiveDocument.ActiveView.viewIsometric()
            Gui.SendMsgToActiveView("ViewFit")
        except Exception:
            pass

    App.Console.PrintMessage(
        "Ready. Select 'KeyParameters' in the tree, edit its Properties, "
        "then Recompute (F5) to update BottomShell/TopShell/KeyAssembled.\n"
    )
    return doc


build()
